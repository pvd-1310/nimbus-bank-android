# Copy this file to .env at the repository root.
APP_MODE=emulator
FIREBASE_PROJECT_ID=demo-mobile-banking
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
HOST=127.0.0.1
PORT=3000
ANDROID_BACKEND_URL=http://10.0.2.2:3000
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# MAPS_API_KEY=your-android-restricted-maps-key
# Generate with: openssl rand -hex 32
OTP_SECRET=replace-with-random-value-at-least-32-characters
DEMO_NAMESPACE=local_demo
DEMO_PASSWORD=replace-with-a-local-demo-password
# For connected mode remove BOTH emulator host variables and set:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-admin.json
# FIREBASE_ADMIN_KEY_PATH=/absolute/private/path/firebase-admin.json
# For a USB-connected Android device, run scripts/connect-android-usb.ps1 and use
# ANDROID_BACKEND_URL=http://127.0.0.1:3001/ in the root .env.
# CONFIRM_SEED_PROJECT=your-spark-project-id
# S3_BUCKET=private-demo-bucket
# AWS_REGION=ap-southeast-1
# AWS_PROFILE=banking-demo
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# GOOGLE_ROUTES_API_KEY=your-server-routes-api-key
# Optional for S3-compatible storage; endpoints in signed URLs must be reachable by Android.
# S3_ENDPOINT=https://private-storage.example.invalid
# S3_FORCE_PATH_STYLE=true
# EKYC_RETENTION_DAYS=90
# Temporary demo mode: only selfie is captured. This does not verify identity or CCCD.
# EKYC_DEMO_SELFIE_ONLY=false
# Compose sets the internal URL. For a backend started with npm on Windows,
# publish Face API on host loopback and set FACE_API_BASE_URL=http://127.0.0.1:8000.
# Generate independently from OTP_SECRET using openssl rand -hex 32.
# FACE_TEMPLATE_KEY_HEX=replace-with-64-hex-characters
# FACE_SIMILARITY=0.55
# Demo CCCD front portrait vs selfie cosine threshold; calibrate with your own consented samples.
# FACE_MIN_MARGIN=0.08
# FACE_THRESHOLDS_MINOR={"VND":100000000}
# FACE_RETENTION_DAYS=365
# FACE_MODEL_PATH=./backend/private-face-model

# Optional guidance-only chatbot. Keep disabled during offline review.
CHATBOT_LOCAL_DEMO=false
CHATBOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
