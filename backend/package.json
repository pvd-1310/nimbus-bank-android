{
  "name": "mobile-banking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed-demo.ts",
    "migrate": "tsx src/scripts/migrate-schema.ts",
    "purge:verification": "node dist/scripts/purge-verification-data.js",
    "worker": "tsx src/scripts/process-outbox.ts",
    "test:emulator": "RUN_EMULATOR_TESTS=1 vitest run test/emulator.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "stripe": "^20.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
