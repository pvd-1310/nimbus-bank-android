<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/login">
    <fragment
        android:id="@+id/login"
        android:name="com.example.final_term.ui.auth.LoginFragment"
        android:label="@string/login_title">
        <action android:id="@+id/action_login_to_customerHome" app:destination="@id/customerHome" />
        <action android:id="@+id/action_login_to_officerHome" app:destination="@id/officerHome" />
    </fragment>
    <fragment
        android:id="@+id/customerHome"
        android:name="com.example.final_term.ui.customer.CustomerHomeFragment"
        android:label="@string/customer_home_title" />
    <fragment
        android:id="@+id/officerHome"
        android:name="com.example.final_term.ui.officer.OfficerHomeFragment"
        android:label="@string/officer_home_title" />
    <fragment
        android:id="@+id/accountList"
        android:name="com.example.final_term.ui.customer.AccountListFragment"
        android:label="Tài khoản và thông báo" />
    <fragment
        android:id="@+id/transactionHistory"
        android:name="com.example.final_term.ui.customer.TransactionHistoryFragment"
        android:label="Lịch sử giao dịch" />
    <fragment
        android:id="@+id/profile"
        android:name="com.example.final_term.ui.profile.ProfileFragment"
        android:label="Cá nhân và cài đặt" />
    <fragment android:id="@+id/accountDetail" android:name="com.example.final_term.ui.customer.AccountDetailFragment" android:label="Chi tiết tài khoản" />
    <fragment android:id="@+id/savingsDetail" android:name="com.example.final_term.ui.customer.SavingsDetailFragment" android:label="Tài khoản tiết kiệm" />
    <fragment android:id="@+id/mortgageDetail" android:name="com.example.final_term.ui.customer.MortgageDetailFragment" android:label="Khoản vay thế chấp" />
    <fragment android:id="@+id/moneyRequest" android:name="com.example.final_term.ui.customer.MoneyRequestFragment" android:label="Yêu cầu nạp/rút" />
    <fragment android:id="@+id/transfer" android:name="com.example.final_term.ui.customer.TransferFragment" android:label="Chuyển tiền" />
    <fragment android:id="@+id/branchLocator" android:name="com.example.final_term.ui.customer.BranchLocatorFragment" android:label="Chi nhánh" />
    <fragment android:id="@+id/officerEkyc" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Hồ sơ eKYC" />
    <fragment android:id="@+id/officerAudit" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Kiểm tra giao dịch" />
    <fragment android:id="@+id/officerRates" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Chính sách lãi suất" />
</navigation>
