<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/login">
    <fragment
        android:id="@+id/login"
        android:name="com.example.final_term.ui.auth.LoginFragment"
        android:label="@string/login_title">
        <action android:id="@+id/action_login_to_customerHome" app:destination="@id/customerHome" />
        <action android:id="@+id/action_login_to_officerHome" app:destination="@id/officerHome" />
    </fragment>
    <fragment
        android:id="@+id/customerHome"
        android:name="com.example.final_term.ui.customer.CustomerHomeFragment"
        android:label="@string/customer_home_title" />
    <fragment
        android:id="@+id/utilitiesHub"
        android:name="com.example.final_term.ui.utilities.UtilitiesHubFragment"
        android:label="Tiện ích &amp; Dịch vụ" />
    <fragment
        android:id="@+id/electricityBill"
        android:name="com.example.final_term.ui.utilities.BillPaymentFragment"
        android:label="Thanh toán tiền điện">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="ELECTRICITY" />
    </fragment>
    <fragment
        android:id="@+id/waterBill"
        android:name="com.example.final_term.ui.utilities.BillPaymentFragment"
        android:label="Thanh toán tiền nước">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="WATER" />
    </fragment>
    <fragment
        android:id="@+id/mobileTopup"
        android:name="com.example.final_term.ui.utilities.MobileTopupFragment"
        android:label="Nạp điện thoại" />
    <fragment
        android:id="@+id/flightBooking"
        android:name="com.example.final_term.ui.utilities.UtilityCatalogFragment"
        android:label="Đặt vé máy bay">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="FLIGHT" />
    </fragment>
    <fragment
        android:id="@+id/movieTickets"
        android:name="com.example.final_term.ui.utilities.UtilityCatalogFragment"
        android:label="Vé xem phim">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="MOVIE" />
    </fragment>
    <fragment
        android:id="@+id/hotelBooking"
        android:name="com.example.final_term.ui.utilities.UtilityCatalogFragment"
        android:label="Đặt khách sạn">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="HOTEL" />
    </fragment>
    <fragment
        android:id="@+id/otherUtilities"
        android:name="com.example.final_term.ui.utilities.BillPaymentFragment"
        android:label="Hóa đơn dịch vụ">
        <argument android:name="serviceType" app:argType="string" android:defaultValue="OTHER" />
    </fragment>
    <fragment
        android:id="@+id/officerHome"
        android:name="com.example.final_term.ui.officer.OfficerHomeFragment"
        android:label="@string/officer_home_title" />
    <fragment
        android:id="@+id/officerCheckingAccounts"
        android:name="com.example.final_term.ui.officer.OfficerCheckingAccountsFragment"
        android:label="Tài khoản thanh toán" />
    <fragment
        android:id="@+id/officerCustomers"
        android:name="com.example.final_term.ui.officer.OfficerCheckingAccountsFragment"
        android:label="Quản lý khách hàng &amp; tài khoản thanh toán" />
    <fragment
        android:id="@+id/officerCustomerForm"
        android:name="com.example.final_term.ui.officer.OfficerCustomerFormFragment"
        android:label="Hồ sơ khách hàng">
        <argument android:name="mode" app:argType="string" android:defaultValue="create" />
        <argument android:name="customerId" app:argType="string" android:defaultValue="" />
        <argument android:name="accountNumber" app:argType="string" android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/accountList"
        android:name="com.example.final_term.ui.customer.AccountListFragment"
        android:label="Tài khoản và thông báo">
        <argument android:name="activeNavItem" app:argType="reference" android:defaultValue="@id/nav_accounts" />
    </fragment>
    <fragment
        android:id="@+id/transactionHistory"
        android:name="com.example.final_term.ui.customer.TransactionHistoryFragment"
        android:label="Lịch sử giao dịch">
        <argument android:name="accountId" app:argType="string" android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/profile"
        android:name="com.example.final_term.ui.profile.ProfileFragment"
        android:label="Cá nhân và cài đặt" />
    <fragment
        android:id="@+id/personalInfo"
        android:name="com.example.final_term.ui.profile.PersonalInfoFragment"
        android:label="Thông tin cá nhân" />
    <fragment
        android:id="@+id/notifications"
        android:name="com.example.final_term.ui.profile.NotificationsFragment"
        android:label="Thông báo" />
    <fragment android:id="@+id/accountDetail" android:name="com.example.final_term.ui.customer.AccountDetailFragment" android:label="Chi tiết tài khoản" />
    <fragment android:id="@+id/historyDetail" android:name="com.example.final_term.ui.customer.HistoryDetailFragment" android:label="Chi tiết lịch sử" />
    <fragment android:id="@+id/savingsDetail" android:name="com.example.final_term.ui.customer.SavingsDetailFragment" android:label="Tài khoản tiết kiệm" />
    <fragment android:id="@+id/mortgageDetail" android:name="com.example.final_term.ui.customer.MortgageDetailFragment" android:label="Khoản vay thế chấp" />
    <fragment android:id="@+id/moneyRequest" android:name="com.example.final_term.ui.customer.MoneyRequestFragment" android:label="Yêu cầu nạp/rút" />
    <fragment android:id="@+id/transfer" android:name="com.example.final_term.ui.customer.TransferFragment" android:label="Chuyển tiền" />
    <fragment
        android:id="@+id/transactionFlow"
        android:name="com.example.final_term.ui.transaction.TransactionExecutionFragment"
        android:label="Xác nhận giao dịch" />
    <fragment android:id="@+id/branchLocator" android:name="com.example.final_term.ui.customer.BranchLocatorFragment" android:label="Chi nhánh" />
    <fragment android:id="@+id/officerEkyc" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Hồ sơ eKYC" />
    <fragment android:id="@+id/officerAudit" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Kiểm tra giao dịch" />
    <fragment android:id="@+id/officerRates" android:name="com.example.final_term.ui.officer.OfficerFeatureFragment" android:label="Chính sách lãi suất" />
    <fragment android:id="@+id/ratePolicyEditor" android:name="com.example.final_term.ui.officer.RatePolicyEditorFragment" android:label="Cập nhật lãi suất" />
    <fragment
        android:id="@+id/resetPassword"
        android:name="com.example.final_term.ui.auth.ResetPasswordFragment"
        android:label="Đặt lại mật khẩu" />
</navigation>
