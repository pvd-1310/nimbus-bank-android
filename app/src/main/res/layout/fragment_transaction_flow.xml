<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <!-- Subtle Frosted Glow Orbs -->
    <View
        android:layout_width="192dp"
        android:layout_height="192dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-64dp"
        android:layout_marginEnd="-64dp"
        android:background="@drawable/bg_glow_orb_white"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="240dp"
        android:background="@drawable/bg_glow_orb_blue"
        android:importantForAccessibility="no" />

    <!-- ============================================== -->
    <!-- STEP 1: CONFIRMATION (Transfer_Confirmation)   -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/step_confirm_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar (56dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_action_button"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/confirm_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/transfer_confirm_title"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/security_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_action_button"
                android:contentDescription="Bảo mật &amp; thông tin"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shield"
                app:tint="@color/navy_deep" />
        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Hero Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/confirm_hero_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="Tổng số tiền chuyển"
                        android:textAllCaps="true"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/confirm_amount_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="@color/ink"
                            android:textSize="38sp"
                            tools:text="1.500.000" />

                        <TextView
                            android:id="@+id/confirm_currency_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-light"
                            android:text="₫"
                            android:textColor="@color/ink_muted"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <!-- Fee Status Pill -->
                    <LinearLayout
                        android:id="@+id/confirm_fee_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/glass_pill_button"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:id="@+id/confirm_fee_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check"
                            app:tint="@color/success" />

                        <TextView
                            android:id="@+id/confirm_fee_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/fee_free"
                            android:textColor="@color/success"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Glass Details Card -->
                <LinearLayout
                    android:id="@+id/confirm_details_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_panel_card"
                    android:orientation="vertical"
                    android:padding="16dp" />

                <LinearLayout
                    android:id="@+id/payment_method_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_panel_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Phương thức thanh toán"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <!-- Option 1: Tài khoản Nimbus -->
                    <LinearLayout
                        android:id="@+id/card_pay_nimbus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_payment_option_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:id="@+id/icon_pay_nimbus"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_wallet"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txt_pay_nimbus_title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:text="Tài khoản Nimbus"
                                    android:textColor="@color/ink"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/btn_change_nimbus_account"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/glass_pill_button"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:text="Đổi"
                                    android:textColor="@color/navy"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txt_pay_nimbus_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Chạm để chọn tài khoản thanh toán"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/payment_account_balance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/navy"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Số dư khả dụng: 38.708.500 ₫" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/radio_pay_nimbus"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_payment_radio_unselected">

                            <ImageView
                                android:id="@+id/check_pay_nimbus"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 2: Thẻ Stripe -->
                    <LinearLayout
                        android:id="@+id/card_pay_stripe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_payment_option_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:id="@+id/icon_pay_stripe"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_card_chip"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_pay_stripe_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="Thẻ Stripe"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txt_pay_stripe_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Thanh toán qua thẻ quốc tế Visa / Mastercard"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/radio_pay_stripe"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_payment_radio_unselected">

                            <ImageView
                                android:id="@+id/check_pay_stripe"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Security Guarantee Banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_pill_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_action_button">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/navy_deep" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="Giao dịch được bảo vệ bằng mã hóa bảo mật và xác thực an toàn qua Nimbus Smart OTP."
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Optional Face Step-Up Card -->
                <LinearLayout
                    android:id="@+id/face_step_up_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_panel_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giao dịch cần xác minh khuôn mặt trước khi tiếp tục xác thực OTP."
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_face_step_up"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Xác minh khuôn mặt"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@color/navy"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <!-- Optional Pending Recovery Card -->
                <LinearLayout
                    android:id="@+id/pending_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_panel_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/pending_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        tools:text="Giao dịch đang chờ hoàn tất thanh toán hoặc đối soát." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pending_action"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Kiểm tra trạng thái"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@color/navy"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Pinned Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_submit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xác nhận &amp; nhập OTP"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/navy"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================== -->
    <!-- STEP 3: SUCCESS RECEIPT (Success_Screen)       -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/step_success_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Mini Header (52dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/success_close_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_action_button"
                android:contentDescription="Đóng"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                app:tint="@color/navy_deep" />

            <TextView
                android:id="@+id/success_mini_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="BIÊN LAI CHUYỂN KHOẢN"
                android:textAllCaps="true"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/success_share_top_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_action_button"
                android:contentDescription="Chia sẻ"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_share"
                app:tint="@color/navy_deep" />
        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Dual-layer Success Badge with Pulse Ring -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="4dp">

                    <View
                        android:id="@+id/success_pulse_ring"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:alpha="0.45"
                        android:background="@drawable/bg_success_outer_ring" />

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_success_outer_ring">

                        <FrameLayout
                            android:id="@+id/success_badge_circle"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_action_button"
                            android:backgroundTint="@color/navy">

                            <ImageView
                                android:id="@+id/success_badge_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="Thành công"
                                android:src="@drawable/ic_check"
                                app:tint="@color/white" />

                            <ProgressBar
                                android:id="@+id/success_badge_spinner"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/white"
                                android:visibility="gone" />
                        </FrameLayout>
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/success_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/transfer_success_title"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <!-- Amount Display -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/success_amount_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink"
                        android:textSize="38sp"
                        tools:text="1.500.000" />

                    <TextView
                        android:id="@+id/success_currency_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-light"
                        android:text="₫"
                        android:textColor="@color/ink_muted"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/success_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp"
                    tools:text="16:20 · 16 Tháng 11, 2026" />

                <!-- Frosted Glass Receipt Card -->
                <LinearLayout
                    android:id="@+id/receipt_details_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/glass_panel_card"
                    android:orientation="vertical"
                    android:padding="20dp" />

                <!-- Trust Assurance Note -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giao dịch được bảo mật bởi Nimbus SafeGuard 256-bit"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Pinned Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_receipt_retry"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Kiểm tra trạng thái"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="#A6FFFFFF"
                app:cornerRadius="999dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_receipt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/share_receipt"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="15sp"
                app:backgroundTint="#A6FFFFFF"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="19dp"
                app:iconTint="@color/navy"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_success_home"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/back_to_home"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/navy"
                app:cornerRadius="999dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
