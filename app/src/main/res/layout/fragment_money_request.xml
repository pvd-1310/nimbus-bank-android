<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/background_gradient" android:padding="20dp">
    <TextView android:id="@+id/title_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Đây là yêu cầu giao dịch; việc thay đổi số dư cần backend xác nhận." android:textColor="@color/ink_muted" />
    <Spinner android:id="@+id/operation_input" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Loại yêu cầu" />
    <Spinner android:id="@+id/account_input" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Tài khoản" />
    <EditText android:id="@+id/amount_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:hint="Số tiền VND (số nguyên)" android:inputType="number" android:maxLength="16" />
    <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/ink_muted" />
    <com.google.android.material.button.MaterialButton android:id="@+id/submit_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Gửi yêu cầu" />
    <com.google.android.material.button.MaterialButton android:id="@+id/history_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Yêu cầu đã gửi" />
</LinearLayout>
</ScrollView>
