<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <!-- Top Segmented Progress + Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:id="@+id/seg_1"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/navy" />

            <View
                android:id="@+id/seg_2"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#262F3E6E" />

            <View
                android:id="@+id/seg_3"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#262F3E6E" />
        </LinearLayout>

        <TextView
            android:id="@+id/step_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="1/3"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable Middle Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Ngân hàng số\nĐơn giản hơn"
                android:textColor="@color/ink"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/onboarding_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:text="Quản lý tiền, thẻ, hóa đơn và chuyển khoản\ntừ một ví di động bảo mật."
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/onboarding_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/glass_pill_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Luôn bảo mật"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/onboarding_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Tiền của bạn, quyền kiểm soát của bạn"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <!-- Preview Stage -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <!-- PAGE 1 PREVIEW: Exact match to Screenshot 3 -->
                <LinearLayout
                    android:id="@+id/page_1_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <!-- Card 1: Recipient -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="13dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nav_person"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Nguyễn Minh Anh"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="TK: 122 6122 8812"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_pill_bg"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="Đổi"
                            android:textColor="@color/ink"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Card 2: Enter Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="3dp"
                        android:orientation="vertical"
                        android:paddingTop="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nhập số tiền"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/glass_pill_bg"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="VND ⌄"
                                android:textColor="@color/ink"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="16dp"
                            android:text="6.250.000 đ|"
                            android:textColor="@color/ink"
                            android:textSize="30sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#082F3E6E"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="11dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thời gian xử lý"
                                android:textColor="@color/ink_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Tức thì - 10 phút"
                                android:textColor="@color/ink"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card 3: Source Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="13dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nav_wallet"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Thẻ Nimbus"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="•••• •••• 4125"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_pill_bg"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="Đổi"
                            android:textColor="@color/ink"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PAGE 2 PREVIEW: Exact match to Screenshot 2 -->
                <LinearLayout
                    android:id="@+id/page_2_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="3dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Hoạt động thu nhập"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tuần này ⌄"
                                android:textColor="@color/ink_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif"
                                    android:text="182,5 Tr đ"
                                    android:textColor="@color/ink"
                                    android:textSize="26sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="↗ +4,2%"
                                    android:textColor="@color/ink_muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- 7-day bar indicator with capsule highlight -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="CN"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />

                                <LinearLayout
                                    android:layout_width="20dp"
                                    android:layout_height="68dp"
                                    android:background="@drawable/navy_button_pill"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="5dp">

                                    <View
                                        android:layout_width="5dp"
                                        android:layout_height="5dp"
                                        android:background="@drawable/circle_action_button" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="T2"
                                        android:textColor="@color/white"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="T3"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="T4"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="T5"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="T6"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingBottom="4dp"
                                    android:text="T7"
                                    android:textColor="@color/ink_faint"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Two bottom stat cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_onboarding_glass_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng doanh thu"
                                android:textColor="@color/ink_muted"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="481.760.000 đ"
                                    android:textColor="@color/ink"
                                    android:textSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/badge_status_success"
                                    android:fontFamily="sans-serif-bold"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="+8%"
                                    android:textColor="@color/success"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_onboarding_glass_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chi tiêu tháng"
                                android:textColor="@color/ink_muted"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="178.570.000 đ"
                                    android:textColor="@color/ink"
                                    android:textSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/badge_status_danger"
                                    android:fontFamily="sans-serif-bold"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="-4%"
                                    android:textColor="@color/danger"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- PAGE 3 PREVIEW: Exact match to Screenshot 1 -->
                <LinearLayout
                    android:id="@+id/page_3_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="Tiền điện"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <!-- Arc of 5 utility icons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="40dp"
                            android:alpha="0.65"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_utility_all"
                                app:tint="@color/ink_muted" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/circle_action_button"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_utility_water"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/circle_action_button"
                            android:elevation="5dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_bolt"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/circle_action_button"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_phone_topup"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="40dp"
                            android:alpha="0.65"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_utility_hotel"
                                app:tint="@color/ink_muted" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Floating Bill Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="18dp"
                        android:layout_marginTop="-6dp"
                        android:background="@drawable/bg_onboarding_white_card"
                        android:elevation="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_action_button">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_utility_electricity"
                                app:tint="@color/navy" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="EVN Hồ Chí Minh"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Điện sinh hoạt"
                                android:textColor="@color/ink_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="498.000 đ"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="#EVN-204815"
                                android:textColor="@color/ink_faint"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Dual Pill Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
