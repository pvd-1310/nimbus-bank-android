<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <!-- Top Navigation Bar (same frosted glass language as eKYC) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_action_button"
            android:contentDescription="Đóng"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="@color/navy" />

        <TextView
            android:id="@+id/face_scan_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Đăng nhập khuôn mặt"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_action_button"
            android:contentDescription="Hướng dẫn quét khuôn mặt"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/navy" />
    </LinearLayout>

    <!-- Status Chips matching eKYC face step -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badge_auto_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_pill_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="Tự động quét · Không cần bấm chụp"
            android:textColor="@color/navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_lighting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_status_success"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="☀ Đủ ánh sáng"
            android:textColor="@color/success"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Scanning Stage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/face_scan_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Xác thực khuôn mặt"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/face_scan_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Đưa khuôn mặt vào khung tròn và nhìn thẳng vào camera"
            android:textColor="@color/ink_muted"
            android:textSize="13.5sp" />

        <!-- Circular eKYC Face Viewport + Progress Ring -->
        <FrameLayout
            android:layout_width="256dp"
            android:layout_height="256dp"
            android:layout_marginTop="22dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/face_scan_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/navy"
                app:indicatorSize="248dp"
                app:trackColor="@color/glass_border"
                app:trackCornerRadius="4dp"
                app:trackThickness="5dp" />

            <FrameLayout
                android:id="@+id/face_viewport_circle"
                android:layout_width="228dp"
                android:layout_height="228dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_action_button">

                <androidx.camera.view.PreviewView
                    android:id="@+id/face_preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/face_captured_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh khuôn mặt vừa quét"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Inner oval guide ring -->
                <View
                    android:id="@+id/face_guide_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp" />

                <!-- Animated horizontal scan line -->
                <View
                    android:id="@+id/face_scan_line"
                    android:layout_width="180dp"
                    android:layout_height="3dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    android:alpha="0.85"
                    android:background="@color/success" />

                <TextView
                    android:id="@+id/face_preview_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/glass_pill_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Đang mở camera..."
                    android:textColor="@color/ink"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- Live scan guidance card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/glass_panel_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/face_scan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Hệ thống sẽ tự động chụp khi nhận diện khuôn mặt rõ nét"
                android:textColor="@color/navy"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Fallback Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gallery"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:text="Chọn ảnh thư viện"
            android:textColor="@color/navy"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_photo_library"
            app:iconSize="18dp"
            app:iconTint="@color/navy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:text="Đóng"
            android:textColor="@color/ink"
            android:textSize="13sp"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
