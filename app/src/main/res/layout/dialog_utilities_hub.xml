<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/utilities_dialog_surface"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hub_main_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiện ích &amp; Thanh toán"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/close_dialog_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_action_button"
                android:contentDescription="Đóng"
                android:padding="8dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/hub_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Thanh toán hóa đơn thiết yếu, nạp tiền điện thoại &amp; dịch vụ"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <!-- ============================================== -->
        <!-- VIEW 1: HUB SELECTION CONTAINER               -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/hub_selection_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Category Tiles Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Electricity -->
                <LinearLayout
                    android:id="@+id/util_electricity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Tiền điện"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tiền điện"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Water -->
                <LinearLayout
                    android:id="@+id/util_water"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Tiền nước"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tiền nước"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Mobile Topup -->
                <LinearLayout
                    android:id="@+id/util_mobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Nạp ĐT"
                        android:src="@drawable/ic_phone_topup"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nạp ĐT"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Internet / More Services -->
                <LinearLayout
                    android:id="@+id/util_internet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Internet"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Internet &amp; DV"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bills Section: Owned Unpaid Invoices -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="HÓA ĐƠN &amp; ĐƠN HÀNG CHỜ THANH TOÁN"
                android:textColor="@color/ink_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:id="@+id/bills_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bills_empty_or_loading_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="Đang tải danh sách hóa đơn từ hệ thống…"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mobile Top-up Form (shown when util_mobile is clicked) -->
            <LinearLayout
                android:id="@+id/topup_form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_panel_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nạp tiền điện thoại trực tiếp (Mobile Top-up)"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/topup_phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_glass_field"
                    android:hint="Nhập số điện thoại (VD: 0987654321)"
                    android:inputType="phone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Chọn mệnh giá nạp (VND):"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <!-- Denomination chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_topup_20k"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/navy_button_pill"
                        android:gravity="center"
                        android:text="20.000 ₫"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_topup_50k"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_pill_button"
                        android:gravity="center"
                        android:text="50.000 ₫"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_topup_100k"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_pill_button"
                        android:gravity="center"
                        android:text="100.000 ₫"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_topup_200k"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_pill_button"
                        android:gravity="center"
                        android:text="200.000 ₫"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proceed_topup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/navy"
                    android:text="Tạo đơn &amp; Thanh toán nạp tiền"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Manual Lookup Form -->
            <LinearLayout
                android:id="@+id/lookup_form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_panel_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/lookup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tra cứu hóa đơn dịch vụ"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/customer_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_glass_field"
                    android:hint="Nhập mã khách hàng / mã hóa đơn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lookup_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/navy"
                    android:text="Tra cứu &amp; Thanh toán"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />

                <TextView
                    android:id="@+id/lookup_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================== -->
        <!-- VIEW 2: CHECKOUT CONTAINER                     -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/checkout_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Checkout Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_panel_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/checkout_service_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hóa đơn thanh toán"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkout_btn_cancel_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="6dp"
                        android:text="Hủy / Sửa"
                        android:textColor="@color/danger"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/checkout_reference_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mã hóa đơn: ..."
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/glass_border" />

                <!-- Price and fee rows from backend intent -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số tiền dịch vụ"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/checkout_amount_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₫"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phí giao dịch"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/checkout_fee_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Miễn phí (0 ₫)"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng thanh toán"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkout_total_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₫"
                        android:textColor="@color/navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/checkout_intent_id_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Intent ID: ..."
                    android:textColor="@color/ink_faint"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Face Verification Step (if faceRequired) -->
            <LinearLayout
                android:id="@+id/checkout_face_step_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_panel_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xác thực khuôn mặt (Face Step-up)"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Giao dịch yêu cầu đối chiếu khuôn mặt với hồ sơ eKYC đã duyệt. Nhận diện ảnh tĩnh là tính năng demo."
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_btn_face"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/navy"
                    android:text="Chụp ảnh mới để xác minh khuôn mặt"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Demo OTP Step -->
            <LinearLayout
                android:id="@+id/checkout_otp_step_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_panel_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xác nhận mã giao dịch"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Mandatory Exact Label -->
                <TextView
                    android:id="@+id/checkout_otp_demo_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/badge_status_neutral"
                    android:padding="8dp"
                    android:text="Mã xác nhận demo — mã hiển thị trong ứng dụng, không gửi qua email/SMS"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Displayed Demo Code next to/above Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã của bạn: "
                        android:textColor="@color/ink_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/checkout_demo_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.2"
                        android:saveEnabled="false"
                        android:text="------"
                        android:textColor="@color/navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/checkout_otp_input"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/input_glass_field"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="••••••"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:letterSpacing="0.4"
                    android:maxLength="6"
                    android:saveEnabled="false"
                    android:textColor="@color/navy"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/checkout_otp_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:text="Tạo mã mới"
                    android:textColor="@color/navy"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_btn_verify_otp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/navy"
                    android:text="Xác thực mã OTP &amp; Tiếp tục"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Commit & Settlement Status Box -->
            <LinearLayout
                android:id="@+id/checkout_commit_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- COMMIT_PENDING Warning Banner -->
                <LinearLayout
                    android:id="@+id/checkout_pending_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_status_warning"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trạng thái: COMMIT_PENDING"
                        android:textColor="@color/warning"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Giao dịch đang chờ cổng thanh toán xác nhận settlement. Số tiền chưa bị trừ nếu chưa có kết quả cuối cùng."
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_btn_commit_pay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/navy"
                    android:text="Xác nhận thanh toán ngay"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />

                <!-- Recovery Button (GET /intents/:id & GET /payments/:id) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_btn_recover"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:text="Tiếp tục thanh toán / kiểm tra kết quả"
                    android:textColor="@color/navy"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/navy"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Status / Error message text -->
            <TextView
                android:id="@+id/checkout_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <!-- ============================================== -->
            <!-- VIEW 3: SUCCESS / RECEIPT CONTAINER           -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/checkout_success_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_panel_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Thành công"
                    android:src="@drawable/ic_check"
                    app:tint="@color/success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Thanh toán thành công (Settled)"
                    android:textColor="@color/success"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receipt_amount_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20.000 ₫"
                    android:textColor="@color/navy"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receipt_details_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Giao dịch đã được hệ thống xác nhận settlement."
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/receipt_btn_done"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/navy"
                    android:text="Hoàn tất"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
