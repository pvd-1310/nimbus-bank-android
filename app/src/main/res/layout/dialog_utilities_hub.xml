<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel_card"
    android:backgroundTint="@color/glass_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiện ích &amp; Hóa đơn"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/close_dialog_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_action_button"
            android:contentDescription="Đóng"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Thanh toán hóa đơn thiết yếu &amp; dịch vụ số"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

    <!-- Utility Service Tiles Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Electricity -->
        <LinearLayout
            android:id="@+id/util_electricity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Tiền điện"
                android:src="@drawable/ic_receipt"
                app:tint="@color/navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tiền điện"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Water -->
        <LinearLayout
            android:id="@+id/util_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Tiền nước"
                android:src="@drawable/ic_receipt"
                app:tint="@color/navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tiền nước"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Mobile Topup -->
        <LinearLayout
            android:id="@+id/util_mobile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Nạp ĐT"
                android:src="@drawable/ic_phone_topup"
                app:tint="@color/navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Nạp điện thoại"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Internet -->
        <LinearLayout
            android:id="@+id/util_internet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Internet"
                android:src="@drawable/ic_receipt"
                app:tint="@color/navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Internet &amp; TV"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lookup Form -->
    <LinearLayout
        android:id="@+id/lookup_form_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/glass_panel_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/lookup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tra cứu hóa đơn điện (EVN)"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/customer_code_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_glass_field"
            android:hint="Nhập mã khách hàng (VD: PE01000123456)"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lookup_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/navy"
            android:text="Tra cứu &amp; Thanh toán"
            android:textColor="@color/white"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/lookup_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
