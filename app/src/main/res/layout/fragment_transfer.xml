<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_action_button"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/transfer_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================== -->
            <!-- STEP 1: INPUT FORM (Transfer_Screen) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/step_input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Segmented Tab: Cùng ngân hàng / Ngân hàng khác -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_pill_button"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tab_internal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/navy_button_pill"
                        android:gravity="center"
                        android:text="@string/transfer_internal"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tab_external"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/transfer_external"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Source Account Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_account"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/source_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/glass_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

                <!-- Recent Recipients Strip (Populated from real transfer history) -->
                <LinearLayout
                    android:id="@+id/recent_recipients_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Người nhận gần đây"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/recent_recipients_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Destination bank (external transfers only) -->
                <LinearLayout
                    android:id="@+id/external_bank_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngân hàng nhận · Napas 24/7 (Miễn phí)"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/external_bank_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/glass_pill_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

                <!-- Target Account Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/destination_account"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/target_input"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:autofillHints="username"
                        android:background="@drawable/input_glass_field"
                        android:hint="@string/destination_hint"
                        android:inputType="text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_faint"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Amount Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amount_label"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/amount_input"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:importantForAutofill="no"
                        android:background="@drawable/input_glass_field"
                        android:fontFamily="sans-serif-medium"
                        android:hint="500.000"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_faint"
                        android:textSize="20sp" />

                    <!-- Quick Amount Chips (+500K, +1M, +5M) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_500k"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/glass_pill_button"
                            android:gravity="center"
                            android:text="+500.000"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chip_1m"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/glass_pill_button"
                            android:gravity="center"
                            android:text="+1.000.000"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chip_5m"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/glass_pill_button"
                            android:gravity="center"
                            android:text="+5.000.000"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Note Input -->
                <EditText
                    android:id="@+id/note_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:importantForAutofill="no"
                    android:background="@drawable/input_glass_field"
                    android:hint="@string/transfer_note"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proceed_to_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/navy"
                    android:text="Tiếp tục"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- STEP 2: CONFIRMATION REVIEW (Transfer_Confirmation) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/step_confirm_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hero Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/confirm_amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng số tiền chuyển"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/confirm_amount_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink"
                        android:textSize="38sp"
                        tools:text="1.500.000 ₫" />

                    <TextView
                        android:id="@+id/confirm_fee_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/badge_status_success"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/fee_free"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Details Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="Chi tiết giao dịch"
                        android:textColor="@color/navy_deep"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/confirm_source_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tài khoản nguồn: Nimbus Bank"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#1A1B2340" />

                    <TextView
                        android:id="@+id/confirm_target_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Người nhận: Tài khoản nhận"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#1A1B2340" />

                    <TextView
                        android:id="@+id/confirm_note_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nội dung: Chuyển khoản Nimbus"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Primary Submit Intent Button (wired to createIntent) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/navy"
                    android:text="Xác nhận chuyển tiền"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back_to_edit"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="Chỉnh sửa thông tin"
                    android:textColor="@color/navy" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- STEP 3: OTP VERIFICATION (OTP_BottomSheet style) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/step_otp_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/glass_panel_card"
                android:elevation="16dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <View
                    android:layout_width="42dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="22dp"
                    android:background="@color/ink_faint" />

                <TextView
                    android:id="@+id/otp_close"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="end|center_vertical"
                    android:text="Đóng"
                    android:textColor="@color/navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/otp_title"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/otp_subtitle"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/face_step_up_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chụp ảnh để xác minh khuôn mặt"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/demo_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:saveEnabled="false"
                    android:textColor="@color/navy"
                    android:textSize="26sp"
                    android:accessibilityLiveRegion="polite" />

                <EditText
                    android:id="@+id/otp_input"
                    android:saveEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:importantForAutofill="no"
                    android:background="@drawable/input_glass_field"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="••••••"
                    android:inputType="number"
                    android:letterSpacing="0.4"
                    android:maxLength="6"
                    android:textColor="@color/navy"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/otp_resend_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:text="Tạo mã mới"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <!-- Action Button wired to verifyOtp -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verify_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/navy"
                    android:text="Xác nhận"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:cornerRadius="18dp" />

                <TextView android:id="@+id/otp_sheet_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:textColor="@color/ink_muted" android:accessibilityLiveRegion="polite" />

                <!-- Commit Button wired to commit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/commit_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/navy"
                    android:text="Kiểm tra trạng thái"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- STEP 4: SUCCESS RECEIPT (Success_Screen) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/step_success_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:visibility="gone">

                <!-- Success Badge -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circle_action_button"
                    android:backgroundTint="@color/navy">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Thành công"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:id="@+id/success_headline"
                    android:text="@string/transfer_success_title"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/success_amount_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/ink"
                    android:textSize="36sp"
                    tools:text="1.500.000 ₫" />

                <!-- Receipt Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/glass_panel_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/receipt_tx_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1A1B2340" />

                    <TextView
                        android:id="@+id/receipt_target_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chuyển đến: Tài khoản nhận"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/receipt_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Thời gian: Vừa xong · Đã ghi nhận"
                        android:textColor="@color/success"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_receipt"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/glass_pill"
                    android:text="@string/share_receipt"
                    android:textColor="@color/ink"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_success_home"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/navy"
                    android:text="@string/back_to_home"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- Status & Error Feedback Message -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
