<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/background_gradient">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="12dp" android:background="@drawable/glass_tile" android:gravity="center" android:text="MA" android:textColor="@color/navy" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chào mừng trở lại 👋" android:textColor="@color/ink_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/identity_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <ImageButton android:id="@+id/notification_button" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_tile" android:contentDescription="Thông báo" android:padding="11dp" android:src="@drawable/ic_nav_notifications" />
                <TextView android:id="@+id/role_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/glass_tile" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/navy" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="@color/glass" app:cardCornerRadius="26dp" app:strokeColor="@color/glass_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số dư khả dụng" android:textColor="@color/ink_muted" android:textSize="13sp" />
                    <TextView android:id="@+id/balance_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Đang tải…" android:textColor="@color/ink" android:textSize="30sp" />
                    <TextView android:id="@+id/account_status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink_muted" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/quick_transfer" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/glass_tile" android:contentDescription="Chuyển tiền" android:padding="16dp" android:src="@drawable/ic_nav_send" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Chuyển tiền" android:textColor="@color/ink" android:textSize="11sp" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/quick_deposit" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/glass_tile" android:contentDescription="Nạp tiền" android:padding="16dp" android:src="@drawable/ic_nav_add" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Nạp tiền" android:textColor="@color/ink" android:textSize="11sp" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/quick_payment" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/glass_tile" android:contentDescription="Thanh toán" android:padding="16dp" android:src="@drawable/ic_nav_payment" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Thanh toán" android:textColor="@color/ink" android:textSize="11sp" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/quick_qr" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/glass_tile" android:contentDescription="Quét QR" android:padding="16dp" android:src="@drawable/ic_nav_qr" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Quét QR" android:textColor="@color/ink" android:textSize="11sp" /></LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Giao dịch gần đây" android:textColor="@color/ink" android:textSize="20sp" />
            <LinearLayout android:id="@+id/recent_transactions_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Thông báo" android:textColor="@color/ink" android:textSize="20sp" />
            <LinearLayout android:id="@+id/notifications_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Thao tác nhanh" android:textColor="@color/ink" android:textSize="20sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/account_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tài khoản và thông báo" />
            <com.google.android.material.button.MaterialButton android:id="@+id/history_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem toàn bộ lịch sử" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/glass_tile" android:padding="14dp" android:text="Chuyển tiền, OTP và thanh toán sẽ mở sau khi backend mutation được bật." android:textColor="@color/ink_muted" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/bottom_navigation" layout="@layout/bottom_navigation" />
</LinearLayout>
