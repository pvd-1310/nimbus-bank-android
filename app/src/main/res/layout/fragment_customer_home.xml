<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp">

            <!-- 1. Header: Avatar + Greeting + Bell -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="2dp"
                    android:background="@drawable/circle_action_button">

                    <TextView
                        android:id="@+id/avatar_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="MA"
                        android:textColor="@color/navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/avatar_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar_image_mask"
                        android:clipToOutline="true"
                        android:contentDescription="Ảnh đại diện"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_back"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/identity_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Minh Anh" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/notification_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_action_button"
                    android:contentDescription="Trợ lý Nimbus"
                    android:padding="12dp"
                    android:src="@drawable/ic_ai_spark"
                    app:tint="@color/navy" />

                <!-- Hidden / accessible role text for compatibility -->
                <TextView
                    android:id="@+id/role_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2. Balance Block (Glass Panel) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/glass_panel_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Ví"
                        android:src="@drawable/ic_nav_wallet"
                        app:tint="@color/ink_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/available_balance"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/toggle_balance_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Ẩn hoặc hiện số dư"
                        android:padding="6dp"
                        android:src="@drawable/ic_eye" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Circular Navy Arrow Button (36dp) -->
                    <ImageButton
                        android:id="@+id/account_details_arrow_btn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/navy_button_pill"
                        android:contentDescription="Xem chi tiết tài khoản"
                        android:elevation="4dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_forward" />
                </LinearLayout>

                <!-- Balance Display -->
                <TextView
                    android:id="@+id/balance_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-light"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="36sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/transaction_limit_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/glass_pill_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/transaction_limit_pill"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/account_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. Quick Actions Row (4 circular 56dp frosted buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. Chuyển tiền -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/quick_transfer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_action_button"
                        android:contentDescription="@string/action_transfer"
                        android:elevation="4dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_nav_send"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/action_transfer"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 2. Nạp tiền -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/quick_deposit"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_action_button"
                        android:contentDescription="@string/action_deposit"
                        android:elevation="4dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_nav_add"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/action_deposit"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 3. Thanh toán -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/quick_payment"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_action_button"
                        android:contentDescription="@string/action_payment"
                        android:elevation="4dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/action_payment"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 4. Quét QR -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/quick_qr"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_action_button"
                        android:contentDescription="@string/action_qr"
                        android:elevation="4dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_nav_qr"
                        app:tint="@color/navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/action_qr"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Recent Transactions Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/glass_panel_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_transactions"
                        android:textColor="@color/ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/history_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="@string/view_all"
                        android:textColor="@color/navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recent_transactions_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 7. Actions & Services Shortcut Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/glass_pill"
                    android:text="Tất cả tài khoản"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/branch_locator_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/glass_pill"
                    android:text="Tìm chi nhánh"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Notifications Container for compatibility -->
            <LinearLayout
                android:id="@+id/notifications_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
